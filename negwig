<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Профессиональные консультации по недвижимости. Покупка, продажа, аренда, проверка документов и сопровождение сделок.">
<title>Эксперт по недвижимости — консультация</title>

<style>
:root{
  --ink:#171717;
  --muted:#686868;
  --line:#dedbd4;
  --paper:#f5f3ee;
  --white:#fff;
  --accent:#b8a27a;
  --dark:#20211f;
  --max:1180px;
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:Arial,Helvetica,sans-serif;
  line-height:1.5;
}

a{
  color:inherit;
  text-decoration:none;
}

.container{
  width:min(calc(100% - 40px),var(--max));
  margin:auto;
}

/* HEADER */

.header{
  position:sticky;
  top:0;
  z-index:20;
  background:rgba(245,243,238,.94);
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--line);
}

.nav{
  height:78px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:28px;
}

.logo{
  font-size:21px;
  font-weight:800;
  letter-spacing:-.04em;
}

.logo span{
  font-weight:400;
  color:var(--muted);
}

.menu{
  display:flex;
  gap:28px;
  font-size:14px;
}

.menu a{
  color:#444;
  transition:.2s;
}

.menu a:hover{
  color:#000;
}

.phone{
  font-weight:700;
  white-space:nowrap;
}

/* HERO */

.hero{
  padding:82px 0 90px;
  background:var(--paper);
}

.hero-grid{
  display:grid;
  grid-template-columns:1.12fr .88fr;
  gap:70px;
  align-items:center;
}

.kicker{
  font-size:13px;
  text-transform:uppercase;
  letter-spacing:.16em;
  color:#7b715f;
  margin-bottom:22px;
}

h1{
  font-size:clamp(46px,6vw,78px);
  line-height:.98;
  letter-spacing:-.055em;
  margin:0 0 28px;
  font-weight:700;
}

.lead{
  font-size:19px;
  line-height:1.55;
  color:#505050;
  max-width:650px;
  margin-bottom:34px;
}

